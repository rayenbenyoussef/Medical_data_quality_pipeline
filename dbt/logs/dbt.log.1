  create view "test"."dbt_stg"."stg_vitalsign__dbt_tmp"
    
    
  as (
    select
    subject_id::INT as patient_id,
    stay_id::INT,
    charttime as chart_time,
    case 
    
    ((temperature - 32) * 5.0 / 9.0)
 as temperature,
    heartrate as heart_rate,
    resprate as resp_rate,
    o2sat as o2_saturation,
    sbp as systolic_bp,
    dbp as diastolic_bp,
    CASE
        WHEN rhythm IN ('Normal Sinus Rhythm', 'sr') THEN 'Sinus Rhythm'
        WHEN rhythm IN ('Atrial Fibrillation', 'afib') THEN 'Atrial Fibrillation'
        ELSE rhythm
    END AS card_rhythm,
    
    CASE
        WHEN pain IN ('ua','standing ','intubated','sitting ','denies','Asleep','laying down',
                                    'Unable','sleeping','u','asleep','sleep ','sleep','NAD',
                                    'sedated','UTA','sleepin','does not scale','uncooperative',
                                    'uta', 'unable', 'ett', 'Critical', '13','UA') THEN NULL
        WHEN pain = 'grimace with palpation' THEN '5'
        WHEN pain = '8.5' THEN '9'
        WHEN pain IN ('o','0/10') THEN '0'
        ELSE pain
    END
::INT as pain_level,
    
    CASE
        WHEN pain IN ('intubated','ett','sedated','Critical')
            THEN 'unable-to-assess'
        WHEN pain IN ('denies','uncooperative')
            THEN 'declined'
        WHEN pain IN ('Asleep','asleep','sleeping','sleep','sleep ',
                                    'sleepin','laying down','sitting ','standing ')
            THEN 'asleep-or-resting'
        WHEN pain IN ('uta','UTA','unable','Unable','u','UA','ua',
                                    'does not scale','NAD','13')
            THEN 'not-assessed'
        ELSE NULL
    END
 as patient_status
from "test"."raw"."vitalsign"
  );
