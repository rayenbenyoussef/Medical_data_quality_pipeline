  create  table "test"."dbt_mrt"."dim_hour__dbt_tmp"
  
  
    as
  
  (
    WITH minute_series AS (
    SELECT GENERATE_SERIES(0, 1439) AS minute_of_day
)

SELECT
    TO_CHAR(
        TIME '00:00' + (minute_of_day * INTERVAL '1 minute'),
