        'HH24:MI'
    ) as recording_hour,
    m.med_id
from "test"."dbt_stg"."stg_medrecon" mr, "test"."dbt_mrt"."dim_medications" m
where lower(mr.medication_name) =lower(m.medication_name)
and mr.gs_num = m.gs_num
  );
  
