  -- This test flags clinically implausible combinations where a patient
-- has the highest acuity (1 = immediate life threat) but reports zero pain.
-- These are almost certainly recording artifacts, not real clinical findings.
-- Returns rows that FAIL the check (dbt expects zero rows for a passing test).

SELECT
    t.stay_id,
    t.pain_score,
    t.acuity,
    t.patient_status,
    e.disposition,
    d.icd_code,
    d.icd_title
FROM "test"."dbt_mrt"."fct_triage" t
LEFT JOIN "test"."dbt_mrt"."fct_ed_visits" e
    ON t.stay_id = e.stay_id
LEFT JOIN "test"."dbt_mrt"."fct_diagnosis" d
    ON t.stay_id = d.stay_id
    AND d.diagnosis_order = 1  -- primary diagnosis only
WHERE t.pain_score = 0
AND t.acuity = 1
AND t.patient_status IS NULL  -- eliminates legitimate "unable to assess" cases
  
  
      
    ) dbt_internal_test
