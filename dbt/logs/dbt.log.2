  create  table "test"."dbt_mrt"."dim_patients__dbt_tmp"
  
  
    as
  
  (
    SELECT
    patient_id,
    MAX(gender) AS gender,
    COALESCE(MAX(CASE WHEN race != 'unknown' THEN race END),'unknown') AS race,
