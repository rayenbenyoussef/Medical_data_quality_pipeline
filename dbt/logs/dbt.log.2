    outtime::timestamp as ed_discharge_time,
    gender,
    
    CASE
        WHEN race LIKE '%WHITE%' THEN 'white'
        WHEN race LIKE '%HISPANIC/LATINO%' THEN 'hispanic/latino'
        WHEN race LIKE '%MULTIPLE%' THEN 'multiple'
        WHEN race LIKE '%BLACK/AFRICAN%' THEN 'black/african'
        ELSE 'unknown'
    END
 as race,
    
    CASE
        WHEN race LIKE '%PORTUGUESE%' THEN 'europe'
        WHEN race LIKE '%BRAZILIAN%' THEN 'south-america'
        WHEN race LIKE '%SALVADORAN%' THEN 'south-america'
        WHEN race LIKE '%CUBAN%' THEN 'south-america'
        WHEN race LIKE '%AMERICAN%' THEN 'north-america'
        WHEN race LIKE '%EUROPEAN%' THEN 'europe'
        ELSE 'unknown'
    END
 as region,
    CASE
        WHEN arrival_transport LIKE '%AMBULANCE%' THEN 'ambulance'
        WHEN arrival_transport LIKE '%WALK IN%' THEN 'walk-in'
        ELSE 'unknown'
    END as arrival_transport,
    LOWER(disposition) as disposition
from "test"."raw"."edstays"
  );
