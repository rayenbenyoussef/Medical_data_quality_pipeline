  create  table "test"."dbt_mrt"."fct_vitalsigns__dbt_tmp"
  
  
    as
  
  (
    select
    stay_id,
    chart_time,
    temperature,
    heart_rate,
    resp_rate,
    o2_saturation,
    systolic_bp,
    diastolic_bp,
    card_rhythm,
    pain_level,
    patient_status
from "test"."dbt_stg"."stg_vitalsign"
WHERE COALESCE(
    temperature,
    heart_rate,
    resp_rate,
    o2_saturation,
    systolic_bp,
    diastolic_bp
) IS NOT NULL
OR card_rhythm IS NOT NULL
OR pain_level IS NOT NULL
OR patient_status IS NOT NULL
  );
  
