  create  table "test"."dbt_mrt"."bridge_triage_complaints__dbt_tmp"
  
  
    as
  
  (
    WITH exploded AS (
    SELECT
        stay_id,
        TRIM(complaint_part) AS complaint_part
    FROM "test"."dbt_stg"."stg_triage",
    LATERAL regexp_split_to_table(chief_complaint, ',') AS complaint_part
    WHERE chief_complaint IS NOT NULL
)

SELECT
    e.stay_id,
    c.complaint_id
FROM exploded e
JOIN "test"."dbt_mrt"."dim_chiefcomplaint" c
    ON TRIM(LOWER(e.complaint_part)) = TRIM(LOWER(c.chief_complaint))
  );
  
