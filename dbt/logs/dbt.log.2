  create  table "test"."dbt_mrt"."fct_pyxis__dbt_tmp"
  
  
    as
  
  (
    select
    ROW_NUMBER() OVER (ORDER by p.stay_id,p.med_row_num,p.gs_num)::INT as dispensing_id,
    p.stay_id,
    p.chart_time::DATE as dispensing_date,
