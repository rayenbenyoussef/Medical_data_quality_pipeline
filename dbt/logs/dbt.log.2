  create  table "test"."dbt_mrt"."fct_pyxis__dbt_tmp"
  
  
    as
  
  (
    WITH dispensing_counts AS (
    SELECT
        stay_id,
        COUNT(*) AS dispensing_count
    FROM "test"."dbt_stg"."stg_diagnosis"
    GROUP BY stay_id
)

select
    ROW_NUMBER() OVER (ORDER by p.stay_id,p.med_row_num,p.gs_num)::INT as dispensing_id,
    p.stay_id,
    p.chart_time::DATE as dispensing_date,
    TO_CHAR(
        TIME '00:00' + (extract(HOUR from p.chart_time) * INTERVAL '1 hour') +
