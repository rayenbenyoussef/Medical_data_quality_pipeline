  create  table "test"."dbt_mrt"."fct_ed_visits__dbt_tmp"
  
  
    as
  
  (
    WITH diagnosis_counts AS (
    SELECT
        stay_id,
        COUNT(*) AS diagnosis_count
    FROM "test"."dbt_stg"."stg_diagnosis"
    GROUP BY stay_id
)

select
    e.stay_id,
    e.patient_id,
    e.ed_arrival_time::DATE as arrival_date,
    TO_CHAR(
        TIME '00:00' + (extract(HOUR from e.ed_arrival_time) * INTERVAL '1 hour') +
        (extract(MINUTE from e.ed_arrival_time) * INTERVAL '1 minute'),
        'HH24:MI'
    ) AS arrival_hour,
    e.ed_discharge_time::DATE as discharge_date,
    TO_CHAR(
        TIME '00:00' + (extract(HOUR from e.ed_discharge_time) * INTERVAL '1 hour') +
        (extract(MINUTE from e.ed_discharge_time) * INTERVAL '1 minute'),
        'HH24:MI'
    ) AS discharge_hour,
    e.arrival_transport,
    CASE
        WHEN COALESCE(dc.diagnosis_count, 0) > 1 THEN 'yes'
        ELSE 'no'
    END AS is_multi_diagnosed,
    e.disposition,
    t.temperature,
    t.heart_rate,
    t.resp_rate,
    t.o2_saturation,
    t.systolic_bp,
    t.diastolic_bp,
    
    CASE
        WHEN t.pain_level IN ('ua','standing ','intubated','sitting ','denies','Asleep','laying down',
                                    'Unable','sleeping','u','asleep','sleep ','sleep','NAD',
                                    'sedated','UTA','sleepin','does not scale','uncooperative',
                                    'uta', 'unable', 'ett', 'Critical', '13','UA') THEN NULL
        WHEN t.pain_level = 'grimace with palpation' THEN '5'
        WHEN t.pain_level = '8.5' THEN '9'
        WHEN t.pain_level IN ('o','0/10') THEN '0'
        ELSE t.pain_level
    END
 AS pain_score,
    
    CASE
        WHEN t.pain_level IN ('intubated','ett','sedated','Critical')
            THEN 'unable-to-assess'
        WHEN t.pain_level IN ('denies','uncooperative')
            THEN 'declined'
        WHEN t.pain_level IN ('Asleep','asleep','sleeping','sleep','sleep ',
                                    'sleepin','laying down','sitting ','standing ')
            THEN 'asleep-or-resting'
        WHEN t.pain_level IN ('uta','UTA','unable','Unable','u','UA','ua',
                                    'does not scale','NAD','13')
            THEN 'not-assessed'
        ELSE NULL
    END
 AS patient_status,
    t.acuity_level
FROM "test"."dbt_stg"."stg_edstays" e
LEFT JOIN "test"."dbt_stg"."stg_triage" t ON e.stay_id = t.stay_id
LEFT JOIN diagnosis_counts dc ON e.stay_id = dc.stay_id
  );
  
