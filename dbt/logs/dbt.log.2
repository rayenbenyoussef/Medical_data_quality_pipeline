        'HH24:MI'
    ) as dispensing_hour,
    p.med_row_num as med_event_num,
    m.med_id
FROM "test"."dbt_stg"."stg_pyxis" p , "test"."dbt_mrt"."dim_medications" m
where p.gs_num=m.gs_num
and p.medication_name =m.medication_name
  );
  
