  create  table "test"."dbt_mrt"."dim_hour__dbt_tmp"
  
  
    as
  
  (
    SELECT
    hour_num,
    LPAD(hour_num::TEXT, 2, '0') || ':00' AS time_hhmm,
    CASE
        WHEN hour_num BETWEEN 0 AND 5 THEN 'Night'
        WHEN hour_num BETWEEN 6 AND 11 THEN 'Morning'
        WHEN hour_num BETWEEN 12 AND 17 THEN 'Afternoon'
        WHEN hour_num BETWEEN 18 AND 23 THEN 'Evening'
    END AS time_of_day,
    CASE
        WHEN hour_num BETWEEN 7 AND 18 THEN 'Business-Hours'
        ELSE 'Off-Hours'
    END AS shift_type
FROM GENERATE_SERIES(0, 23) AS hour_num
  );
  
