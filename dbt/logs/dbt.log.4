    ROW_NUMBER() OVER (ORDER BY medication_name, gs_num) AS med_id,
    medication_name,
    gs_num,
    MAX(ndc) AS ndc,
    MAX(etc_code) AS etc_code
FROM combined_medications
GROUP BY medication_name, gs_num
  );
  
