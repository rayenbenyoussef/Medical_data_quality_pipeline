  create  table "test"."dbt_mrt"."dim_medications__dbt_tmp"
  
  
    as
  
  (
    WITH combined_medications AS (
    SELECT DISTINCT
        TRIM(LOWER(medication_name)) as medication_name,
        ndc,
        gs_num,
        etc_code
    FROM "test"."dbt_stg"."stg_medrecon"

    UNION

    SELECT DISTINCT
        TRIM(LOWER(medication_name)) as medication_name,
        NULL::BIGINT as ndc,
        gs_num,
        NULL::INT as etc_code
    FROM "test"."dbt_stg"."stg_pyxis"
)

select distinct
    medication_name,
    ndc,
    gs_num,
    etc_code,
    etc_description
FROM combined_medications

SELECT
    ROW_NUMBER() OVER (ORDER BY medication_name) AS med_id,
    medication_name,
    ndc,
    gs_num,
    etc_code,
    etc_description
FROM (select distinct
    medication_name,
    ndc,
    gs_num,
    etc_code,
    etc_description
    FROM combined_medications);
  );
  
