  create  table "test"."dbt_mrt"."dim_patients__dbt_tmp"
  
  
    as
  
  (
    SELECT
    patient_id,
    MAX(gender) AS gender,
    MAX(CASE WHEN race != 'unknown' THEN race END) AS race,
    MAX(CASE WHEN region != 'unknown' THEN region END) AS region
FROM "test"."dbt_stg"."stg_edstays"
GROUP BY patient_id
  );
  
