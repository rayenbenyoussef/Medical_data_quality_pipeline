SELECT
    TO_CHAR(
        TIME '00:00' + (minute_of_day * INTERVAL '1 minute'),
        'HH24:MI'
    ) AS time_hhmm,
    (minute_of_day / 60) AS hour_num,
    (minute_of_day % 60) AS minute_num
FROM minute_series
  );
  
