  create  table "test"."dbt_mrt"."fct_ed_visits__dbt_tmp"
  
  
    as
  
  (
    select distinct
    stay_id,
    patient_id,
    ed_arrival_time::DATE as arrival_date,
    TO_CHAR(
        TIME '00:00' + (extract(HOUR from ed_arrival_time) * INTERVAL '1 hour') +
        (extract(MINUTE from ed_arrival_time) * INTERVAL '1 minute'),
        'HH24:MI'
    ) AS arrival_hour,
    ed_discharge_time::DATE as discharge_date,
    TO_CHAR(
        TIME '00:00' + (extract(HOUR from ed_discharge_time) * INTERVAL '1 hour') +
        (extract(MINUTE from ed_discharge_time) * INTERVAL '1 minute'),
        'HH24:MI'
    ) AS discharge_hour,
    arrival_transport,
    disposition
from "test"."dbt_stg"."stg_edstays"
  );
  
